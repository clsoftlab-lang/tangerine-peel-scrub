#
# 귤결 AI 프록시 환경변수 예시.
# 이 파일을 복사해 .env 를 만들고 실제 키를 넣으세요:  cp .env.example .env
# ⚠️ .env 는 git 에 커밋하지 마세요(.gitignore 로 제외됨). 키는 서버에만 둡니다.

# Anthropic API 키 (서버 사이드 전용). 아래 자리표시자를 실제 키로 교체하세요.
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# 프록시 포트 (선택, 기본 8787)
PORT=8787

# 고도화(선택) — 무인·저비용 실 AI 연동
# 비용 우선 기본 모델. 품질을 높이려면 claude-sonnet-5 / claude-opus-5 로 상향.
AI_MODEL=claude-haiku-4-5
# 태스크당 출력 토큰 상한 (기본 700)
AI_MAX_TOKENS=700
# 월 토큰 예산 (초과 시 429 {fallback:true} → 프런트 목업 폴백)
AI_MONTHLY_TOKEN_CAP=2000000
# IP당 분당 요청 상한 (기본 20)
AI_RATE_PER_MIN=20
# haiku 가 아닌 모델에서만 사용되는 사고 강도 (기본 low)
AI_EFFORT=low
